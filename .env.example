# Скопируй в .env.local и подставь значения.
#
# Локальные значения не секретны: `npm run db:start` поднимает Supabase с фиксированными
# демонстрационными ключами, одинаковыми на всех машинах. Реальные ключи проекта берутся
# в панели Supabase и в git не попадают (.env.* в .gitignore).

# Адрес Supabase API. Локально его печатает `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Публикуемый ключ. Он ПО ЗАМЫСЛУ попадает в клиентский бандл и виден любому посетителю:
# защита данных держится не на его секретности, а на политиках RLS (§8.2).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Базовый адрес приложения. Используется как цель редиректа в письме подтверждения:
# ссылка обязана вести на наш домен, иначе письмом можно угнать сессию.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Служебный ключ. Обходит RLS полностью, поэтому появился только тогда, когда возникла
# операция, которую иначе не сделать: запись файла в хранилище.
#
# §7 требует проверять MIME по сигнатуре содержимого. Проверить содержимое может лишь тот,
# у кого байты на руках, — сервер; но пока запись в бакет разрешена роли authenticated,
# те же права есть у браузера, и проверку обходит любой клиент одним запросом. Отличить
# наш сервер от браузера можно только тем, чего у браузера нет. Разбор в ADR-0008.
#
# Используется ровно в одном месте (src/lib/supabase/service.ts) и только для записи
# файлов: права на чтение по-прежнему решают политики.
#
# Префикса NEXT_PUBLIC_ не получит никогда; утечку в клиентский бандл механически
# проверяет CI (.github/workflows/ci.yml). Локальное значение печатает `npx supabase status`
# — оно не секретно, но и в репозиторий не переносится: пусть привычка будет одна.
SUPABASE_SERVICE_ROLE_KEY=
